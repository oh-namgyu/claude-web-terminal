# Copy to .env and adjust.

# Bind host. Default 127.0.0.1 (loopback only). Do NOT change to 0.0.0.0 on an
# untrusted network — /api/cc-sessions exposes session cwds, names and the
# last assistant message of every active Claude Code session.
HOST=127.0.0.1

# Port for the web terminal.
PORT=8765

# Optional: absolute path to the `claude` CLI binary. If unset, PATH is searched.
# CLAUDE_BIN=/usr/local/bin/claude

# Optional: default working directory for new tabs. Falls back to your home dir.
# DEFAULT_CWD=/absolute/path/to/your/repos

# Optional: comma-separated root dirs whose first-level children populate the
# cwd dropdown. Children named devs/docs/repos/projects/code get one extra
# nesting level (each grandchild is usually a project). `~` is expanded.
# Defaults to your home dir.
# CWD_ROOTS=~/projects,~/work

# Optional: comma-separated extra Origins allowed on /api/* and the WebSocket
# upgrade. MERGED with the built-in loopback set (http+https on
# localhost/127.0.0.1/HOST). Set when fronting the server with a custom origin,
# e.g. a TLS reverse proxy on https://cwt.local.
# ALLOWED_ORIGINS=https://cwt.local

# Optional: allow WebSocket upgrades that carry NO Origin header. Off by
# default — a missing Origin is treated as a non-browser caller riding the
# auth cookie and rejected (same policy as state-changing POSTs). Set to 1 or
# true only for native/non-browser clients or tests.
# ALLOW_NO_ORIGIN_WS=false

# Optional: fixed loopback auth token. If unset, a random 192-bit token is
# generated each time the server starts and printed to the console as
# `http://127.0.0.1:8765/?t=<token>`. Open that URL once to set an httpOnly
# cookie; subsequent visits to `/` work without the token. Set this to a fixed
# value if you want the bootstrap URL to remain stable across restarts.
# AUTH_TOKEN=

# Optional: hide the token from the bootstrap URL printed at startup. With
# true the URL becomes `?t=abcd…ef` so screen-shares / persisted logs don't
# leak the secret. You then need to know AUTH_TOKEN out-of-band. Default false.
# AUTH_TOKEN_HIDE=false

# Optional: max session-create requests per minute per auth cookie. Cap is a
# safety net against runaway loops that spawn one child process per call.
# Default 30.
# RATE_LIMIT_PER_MIN=30

# Optional: local session browser. Lists the Claude Code transcripts on this
# machine (`~/.claude/projects/*/*.jsonl`) so you can reopen one in a tab as
# `claude --resume <id>`. Set to 0 to remove it end to end — the API route
# 404s and the UI entry point never appears. Default on.
# RESUME_BROWSER=1

# Optional: show the last user message of each session as a one-line preview
# in that browser. Set to 0 to list sessions without their prompt text.
# Default on.
# RESUME_PREVIEW=1

# Optional: colon-separated absolute dirs a resumed session may run in. The
# working directory comes from the session transcript, never from the browser,
# and is rejected (nothing spawns) unless its realpath lands inside one of
# these roots. `~` is expanded. Defaults to your home dir.
# ALLOWED_RESUME_ROOTS=/Users/you/projects:/Users/you/work

# Optional: structured-logging level + format.
#   LOG_LEVEL  = debug | info (default) | warn | error
#   LOG_FORMAT = text (default, single-line) | json (one object per line)
# Use json when forwarding to container log scrapers / Loki / jq.
# LOG_LEVEL=info
# LOG_FORMAT=text
